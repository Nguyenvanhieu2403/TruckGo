APP_ENV=dev

POSTGRES_DB=truckgo
POSTGRES_USER=truckgo_app
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

BACKEND_PORT=8080
FRONTEND_PORT=4200

CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Sprint 2: authentication ---
# Base64 HMAC key, >= 32 bytes. Generate with: openssl rand -base64 48
# Mandatory when APP_ENV=prod. Empty in dev = random key per restart (everyone is logged out on restart).
JWT_SECRET=
JWT_ISSUER=truckgo-api
JWT_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# false only for plain-HTTP localhost. Must be true with APP_ENV=prod (startup fails otherwise).
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Strict
LOGIN_MAX_FAILURES=5
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_RATE_LIMIT_WINDOW=15m

# Only for the one-shot first-admin command (see README). Do not keep real values here.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULL_NAME=

# --- Sprint 3: shipments and photo storage ---
# minio (any S3-compatible endpoint) or none (photo uploads return 503).
STORAGE_PROVIDER=minio
MINIO_ROOT_USER=truckgo_minio
# At least 8 characters. Change it outside your own machine.
MINIO_ROOT_PASSWORD=change_me_minio_local
MINIO_BUCKET=truckgo-private
# Application credentials (created by the minio-init service, limited to MINIO_BUCKET). The backend uses only these.
MINIO_APP_ACCESS_KEY=truckgo_app
MINIO_APP_SECRET_KEY=change_me_minio_app
# Orphaned-object sweep: logs only (dry run) until set to false.
STORAGE_ORPHAN_DRY_RUN=true
MINIO_PORT=9000
# Time zone for shipment codes and date filters.
SHIPMENT_BUSINESS_ZONE=Asia/Ho_Chi_Minh

# --- Sprint 4: pricing ---
# none: quotes wait for an admin-verified distance; osrm: free OSRM routing (needs stop coordinates);
# mapbox: Mapbox Directions (needs MAPBOX_ACCESS_TOKEN and coordinates); google: Google Directions API.
# A failing provider never falls back to another one or to a straight line: the quote waits for an admin.
MAPS_ROUTE_PROVIDER=none
OSRM_BASE_URL=https://router.project-osrm.org
MAPBOX_ACCESS_TOKEN=
MAPS_ROUTE_MAX_ATTEMPTS=2
MAPS_ROUTE_CACHE_TTL=7d
# Bump to drop every cached route (e.g. after changing the OSRM data).
MAPS_ROUTE_CACHE_VERSION=1
MAPS_ROUTE_QUOTA_PER_HOUR=500
MAPS_ROUTE_QUOTA_PER_DAY=5000
# Address search/geocoding: none (manual addresses, default), photon or osm (free, OpenStreetMap data, no key)
# or google (Geocoding API, same key below). Free public servers are for light use; self-host for production.
MAPS_GEOCODING_PROVIDER=none
# Free map tiles shown in the browser (attribution is mandatory) and free OSRM routing for quotes.
MAPS_TILE_URL=https://tile.openstreetmap.de/{z}/{x}/{y}.png
MAPS_TILE_ATTRIBUTION=© OpenStreetMap contributors
# Never commit a real key. Restrict it to the Directions/Geocoding APIs and your server IPs in Google Cloud.
GOOGLE_MAPS_API_KEY=
MAPS_CONNECT_TIMEOUT=3s
MAPS_READ_TIMEOUT=5s
# How long a calculated quote can be accepted.
QUOTE_VALIDITY=24h
# Background job that marks calculated quotes past their validity EXPIRED.
QUOTE_EXPIRY_JOB_ENABLED=true
QUOTE_EXPIRY_INTERVAL=5m
QUOTE_EXPIRY_BATCH_SIZE=200
# Re-pricing limits (429 + Retry-After when exceeded).
QUOTE_PREVIEW_PER_SHIPMENT=5
QUOTE_PREVIEW_WINDOW=10m
QUOTE_PREVIEW_PER_CUSTOMER_HOUR=30
PRICING_CACHE_TTL=10m
# Marketplace (Sprint 5): drivers apply until this long before pickup; open orders expire at pickup time.
MARKETPLACE_APPLICATION_CUTOFF=1h
MARKETPLACE_MAX_PENDING_PER_DRIVER=10
MARKETPLACE_CACHE_TTL=30s
MARKETPLACE_EXPIRY_INTERVAL=5m
# A trip keeps its driver and vehicle busy from pickup to the delivery deadline (or pickup + default duration) plus the buffer.
MARKETPLACE_SCHEDULE_BUFFER=1h
MARKETPLACE_DEFAULT_TRIP_DURATION=8h
# Realtime notification stream (server-sent events).
NOTIFICATION_STREAM_TIMEOUT=10m
NOTIFICATION_HEARTBEAT=25s
NOTIFICATION_REPLAY_LIMIT=100
# Trips (Sprint 6). OTP codes are stored as HMACs; blank secret = derived from JWT_SECRET.
TRIP_OTP_TTL=30m
TRIP_OTP_MAX_ATTEMPTS=5
TRIP_OTP_RESEND_COOLDOWN=60s
TRIP_OTP_MAX_SENDS=5
TRIP_OTP_SECRET=
TRIP_OTP_CHANNEL=in-app
TRIP_REQUIRE_DELIVERY_PHOTO=false
TRACKING_MIN_INTERVAL=3s
TRACKING_LIVE_THRESHOLD=60s
TRACKING_STALE_THRESHOLD=5m
TRACKING_MAX_SPEED_KMH=200
TRACKING_RETENTION=90d
